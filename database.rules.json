{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || (!data.exists() && newData.child('hostUid').val() === auth.uid))",
        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "guestUid": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('rooms/' + $code + '/status').val() === 'waiting' && root.child('rooms/' + $code + '/hostUid').val() !== auth.uid",
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|playing|finished|closed)$/)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/guestUid').val() === auth.uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "lives": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
            "shieldsUsed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "online": { ".validate": "newData.isBoolean()" }
          }
        },
        "rematch": {
          "$uid": {
            ".validate": "$uid === auth.uid && newData.isBoolean()"
          }
        },
        "emotes": {
          "$uid": {
            ".validate": "$uid === auth.uid && newData.hasChildren(['e', 'at']) && newData.child('at').val() === now",
            "e": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "rounds": {
          "$round": {
            "commits": {
              "$uid": {
                ".validate": "$uid === auth.uid && !data.exists() && newData.child('hash').isString() && newData.child('at').val() === now"
              }
            },
            "reveals": {
              "$uid": {
                ".validate": "$uid === auth.uid && !data.exists() && newData.child('spell').isString() && newData.child('salt').isString() && data.parent().parent().child('commits/' + auth.uid).exists()"
              }
            }
          }
        }
      }
    },
    "tournaments": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('status').val() === 'lobby') || data.child('hostUid').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z0-9]{5}$/) && newData.hasChildren(['hostUid', 'status'])",
        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|running|finished|cancelled)$/)"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "startedAt": { ".validate": "newData.isNumber()" },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('tournaments/' + $code + '/hostUid').exists() && (data.exists() || (root.child('tournaments/' + $code + '/status').val() === 'lobby'))",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "tag": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "seeds": {
          "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 128" }
        },
        "rooms": {
          "$match": {
            ".write": "auth != null && root.child('tournaments/' + $code + '/status').val() === 'running' && root.child('tournaments/' + $code + '/players/' + auth.uid).exists()",
            ".validate": "$match.matches(/^r[0-9]m[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 8"
          }
        },
        "results": {
          "$match": {
            ".write": "auth != null && !data.exists() && root.child('tournaments/' + $code + '/status').val() === 'running' && root.child('tournaments/' + $code + '/players/' + auth.uid).exists()",
            ".validate": "$match.matches(/^r[0-9]m[0-9]{1,2}$/) && newData.hasChildren(['winner', 'at']) && newData.child('at').val() === now && root.child('tournaments/' + $code + '/players/' + newData.child('winner').val()).exists()",
            "winner": { ".validate": "newData.isString()" },
            "at": { ".validate": "newData.isNumber()" },
            "walkover": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      ".indexOn": ["wins"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "losses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "tag": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "tag": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/) && (!data.exists() || newData.val() === data.val())" },
        "progress": {
          "xp": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "losses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "streak": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "lastDuel": { ".validate": "newData.hasChildren(['opponentName', 'won', 'playedAt'])" },
          "stats": {
            "$key": { ".validate": "$key.matches(/^[a-zA-Z_]{1,24}$/) && newData.isNumber() && newData.val() >= 0" }
          },
          "badges": {
            "$id": { ".validate": "$id.matches(/^[a-z_]{1,32}$/) && newData.isNumber() && newData.val() >= 0" }
          },
          "$other": { ".validate": false }
        },
        "recent": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['name', 'lastPlayed'])",
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "losses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "lastPlayed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },
        "friendCode": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val()) && newData.parent().parent().parent().child('friendCodes/' + newData.val()).val() === $uid"
        },
        "$other": { ".validate": false }
      }
    },
    "friendCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && $code.matches(/^[A-Z0-9]{6}$/)"
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && $from !== $to && (auth.uid === $from || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'at'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "tag": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && $from !== $to && ((auth.uid === $from && (!newData.exists() || root.child('friends/' + $to + '/' + $from).exists())) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'roomCode', 'at'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "tag": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
          "roomCode": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{4}$/)" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$token": { ".validate": "newData.isBoolean()" }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && $uid !== $other && ((!newData.exists() && (auth.uid === $uid || auth.uid === $other)) || (auth.uid === $uid && root.child('friendRequests/' + $uid + '/' + $other).exists()) || (auth.uid === $other && root.child('friendRequests/' + $other + '/' + $uid).exists()))",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
